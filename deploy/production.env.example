# Copy to deploy/production.env and fill in. Never commit the real file.
APP_ENV=production
PUBLIC_URL=https://crm.dssuniforms.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# 'live' actually sends messages, calls and posts. Anything else records them as "test mode — not delivered".
DELIVERY_MODE=live
# Claude API key for Natalie and Arev (https://console.anthropic.com). Without it, AI shows "Needs setup".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Website origins allowed to use the chat widget and quote form
SITE_ORIGINS=https://dssuniforms.com,https://www.dssuniforms.com
TRUST_PROXY=true
# docker-compose database credentials (also put these in your shell or --env-file)
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=
