# Copy to deploy/staging.env. Staging NEVER delivers: messages, calls and posts are recorded as test only,
# whatever DELIVERY_MODE says. Use separate (test) Twilio/Meta credentials here if you connect any.
APP_ENV=staging
PUBLIC_URL=https://staging-crm.dssunifoems.com
APP_ENCRYPTION_KEY=
DELIVERY_MODE=sandbox
ANTHROPIC_API_KEY=
SITE_ORIGINS=https://dssunifoems.com
TRUST_PROXY=true
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=
APP_PORT=8081
