{
  "name": "ds-crm",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "DS Systems CRM",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node server/src/migrate.js",
    "seed:test": "node server/scripts/seed-test.js",
    "start": "node server/src/index.js",
    "worker": "node server/src/worker.js",
    "dev": "node --watch server/src/index.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "build:web": "cd web && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
